{
  "name": "legacy-institutional",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "screenshots": "node scripts/capture.mjs",
    "format": "prettier --write src scripts tests *.mjs *.ts *.json DESIGN.md README.md",
    "format:check": "prettier --check src scripts tests *.mjs *.ts *.json DESIGN.md README.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
